hal_client_domain(hal_camera_default, hal_power)
vndbinder_use(hal_camera_default)
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_camera_default sprd_sensor_device:chr_file rw_file_perms;
allow hal_camera_default vendor_data_file:dir r_dir_perms;
allow hal_camera_default vendor_data_file:file r_file_perms;
allow hal_camera_default sysfs_scene_frequency:file { getattr open write };
allow hal_camera_default sysfs:file rw_file_perms;
set_prop(hal_camera_default, vendor_camera_prop)
get_prop(cameraserver, vendor_camera_prop)
