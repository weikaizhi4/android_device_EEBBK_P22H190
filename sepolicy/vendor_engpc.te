type vendor_engpc_default, domain;
type vendor_engpc_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_engpc_default)
allow vendor_engpc_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow vendor_engpc_default proc_cmdline:file r_file_perms;
allow vendor_engpc_default serial_device:chr_file rw_file_perms;
allow vendor_engpc_default sysfs_android_usb:dir r_dir_perms;
allow vendor_engpc_default sysfs_android_usb:file r_file_perms;
